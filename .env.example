# The application runs without external services in deterministic simulator mode.
DEMO_DATABASE_PATH=./data/commerce-support.sqlite
DEMO_AI_PROVIDER=simulator
DEMO_SECURITY_PROVIDER=simulator
KORESHIELD_MODE=enforce

# Optional live AI provider. Keep this server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional live Koreshield integration. Keep the key server-side.
KORESHIELD_API_URL=https://api.koreshield.com
KORESHIELD_API_KEY=
